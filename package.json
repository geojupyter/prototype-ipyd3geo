{
  "name": "ipyd3geo",
  "private": true,
  "description": "An interactive map widget for Jupyter that uses D3 Geo as its renderer.",
  "scripts": {
    "build": "esbuild js/widget.js --bundle --format=esm --minify --outfile=src/ipyd3geo/static/widget.js",
    "dev": "esbuild js/widget.js --bundle --format=esm --sourcemap=inline --watch --outfile=src/ipyd3geo/static/widget.js"
  },
  "keywords": [
    "jupyter",
    "widget",
    "anywidget",
    "d3",
    "d3-geo",
    "map",
    "gis"
  ],
  "author": "Benjamin Szeghy",
  "license": "BSD-3-Clause",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.17.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "d3-geo": "^3.1.1",
    "d3-geo-polygon": "^2.0.1",
    "d3-geo-projection": "^4.0.0",
    "d3-selection": "^3.0.1",
    "d3-zoom": "^3.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
